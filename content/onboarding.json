    { "id": "longCrop",          "triggers": [{ "kind": "step" }], "action": "field:86" },
    { "id": "comeBack",          "triggers": [{ "kind": "step" }] },
    { "id": "firstReturn",       "triggers": [{ "kind": "awayCard" }] },
    { "id": "firstFieldHarvest", "triggers": [{ "kind": "event", "events": ["CropHarvested"] }] },
    { "id": "pest",              "triggers": [{ "kind": "event", "events": ["PestWarning"] }], "action": "alerts" },
    { "id": "sellOrStore",       "triggers": [{ "kind": "storeAbovePercent", "percent": 90 }, { "kind": "traderFull" }], "action": "store" },
    { "id": "seasonReport",      "triggers": [{ "kind": "event", "events": ["SeasonClosed"] }], "action": "report" },
    { "id": "season.summer",     "triggers": [{ "kind": "seasonStart", "season": "summer" }] },
    { "id": "season.monsoon",    "triggers": [{ "kind": "seasonStart", "season": "monsoon" }] },
    { "id": "season.winter",     "triggers": [{ "kind": "seasonStart", "season": "winter" }], "action": "founder" },
