    { "id": "longCrop",  "goal": { "kind": "cropSown", "minGrowthHours": 12 },      "highlight": "tile:86", "chapter": "longCrop" },
    { "id": "comeBack",  "goal": { "kind": "chapterClosed" },                                             "chapter": "comeBack" }
  ],
  "chapters": [
    { "id": "welcome",           "triggers": [{ "kind": "step" }] },
    { "id": "garden",            "triggers": [{ "kind": "step" }], "action": "bed:1" },
    { "id": "household",         "triggers": [{ "kind": "step" }], "action": "founder" },
    { "id": "firstPick",         "triggers": [{ "kind": "step" }], "action": "store" },
