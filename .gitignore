# Farm to City .gitignore
#
# The Unity rules are re-rooted to unity/FarmToCity/ (ADR 0018 rule 9), so the
# hand-written .sln, .csproj and Directory.Build.props at the repository root
# and under sim/, tests/ and tools/ are committed.

# ---------------------------------------------------------------------------
# .NET build output (Directory.Build.props sends everything to /artifacts)
# ---------------------------------------------------------------------------
/artifacts/
bin/
obj/
TestResults/
*.trx

# ---------------------------------------------------------------------------
# Unity project: unity/FarmToCity/
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# ---------------------------------------------------------------------------
/unity/FarmToCity/.utmp/
/unity/FarmToCity/[Ll]ibrary/
/unity/FarmToCity/[Tt]emp/
/unity/FarmToCity/[Oo]bj/
/unity/FarmToCity/[Bb]uild/
/unity/FarmToCity/[Bb]uilds/
/unity/FarmToCity/[Ll]ogs/
/unity/FarmToCity/[Uu]ser[Ss]ettings/
/unity/FarmToCity/[Mm]emoryCaptures/
/unity/FarmToCity/[Rr]ecordings/
/unity/FarmToCity/[Aa]ssets/Plugins/Editor/JetBrains*
/unity/FarmToCity/ExportedObj/
/unity/FarmToCity/.consulo/

# Unity generates its own .csproj and .sln inside the Unity project; ours live elsewhere.
/unity/FarmToCity/*.csproj
/unity/FarmToCity/*.unityproj
/unity/FarmToCity/*.sln
/unity/FarmToCity/*.slnx

# Blender backup files
*.blend1
*.blend1.meta

# Generated by Unity on crash reports and by the test runner
sysinfo.txt
mono_crash.*
/unity/FarmToCity/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/unity/FarmToCity/[Aa]ssets/[Ss]ceneDependencyCache*
/unity/FarmToCity/UIElementsSchema/

# Addressables
/unity/FarmToCity/ServerData
/unity/FarmToCity/[Aa]ssets/StreamingAssets/aa*
# Content copied from content/ by ContentBuildStep before each player build
/unity/FarmToCity/[Aa]ssets/StreamingAssets/content/
/unity/FarmToCity/[Aa]ssets/StreamingAssets/content.meta
/unity/FarmToCity/[Aa]ssets/StreamingAssets/golden/
/unity/FarmToCity/[Aa]ssets/StreamingAssets/golden.meta
/unity/FarmToCity/[Aa]ssets/StreamingAssets.meta
/unity/FarmToCity/[Aa]ssets/AddressableAssetsData/link.xml*
/unity/FarmToCity/[Aa]ssets/Addressables_Temp*
/unity/FarmToCity/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/unity/FarmToCity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/unity/FarmToCity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/unity/FarmToCity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/unity/FarmToCity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Build products
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------------
# OS and editor files
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vs/
# Editor settings at any depth (root and unity/FarmToCity/). Unity's VS Code package regenerates
# launch.json and settings.json; only the extension recommendations are shared.
**/.vscode/*
!**/.vscode/extensions.json
.gradle/
*.suo
*.user
*.userprefs
*.DotSettings.user
*.booproj
*.svd

# Editor captures for reviewing screens (capture_game_view saves inside Assets only)
/unity/FarmToCity/[Aa]ssets/_Captures*
